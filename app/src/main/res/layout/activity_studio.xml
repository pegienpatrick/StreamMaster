<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <SurfaceView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <net.ossrs.yasea.demo.studio.SceneEditorView
        android:id="@+id/editor"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- top: row 1 = destination + actions, row 2 = live status -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipDest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/chip_bg"
                android:drawablePadding="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingTop="9dp"
                android:paddingEnd="12dp"
                android:paddingBottom="9dp"
                android:text="Set destination"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnKiosk"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/icon_button_background"
                android:contentDescription="Kiosk mode"
                android:src="@drawable/ic_lock" />

            <ImageButton
                android:id="@+id/btnPip"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/icon_button_background"
                android:contentDescription="Picture in picture"
                android:src="@drawable/ic_pip" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/icon_button_background"
                android:contentDescription="Settings"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipLive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_live_bg"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="LIVE 00:00"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/chipRec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/chip_bg"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="REC 00:00"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/chipStats"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/chip_bg"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:textColor="@color/on_surface_dim"
                android:textSize="11sp" />

            <ProgressBar
                android:id="@+id/micMeter"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="48dp"
                android:layout_height="6dp"
                android:layout_marginStart="10dp"
                android:max="100"
                android:progressTint="@color/ok_green" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="72dp"
        android:background="@drawable/chip_bg"
        android:maxWidth="360dp"
        android:padding="12dp"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- appears while a layer is selected: layering + quick actions -->
    <HorizontalScrollView
        android:id="@+id/layerBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="130dp"
        android:background="@drawable/bar_bg"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/lbFront"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="To front" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/lbForward"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Forward" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/lbBackward"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Backward" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/lbBack"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="To back" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/lbEdit"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/lbDelete"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delete"
                android:textColor="@color/live_red" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- bottom: tools (scrollable) + record / go live. On phones these stack in two rows. -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bar_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="10dp">

        <HorizontalScrollView
            android:id="@+id/toolsScroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnSources"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/icon_button_background"
                    android:contentDescription="Sources"
                    android:src="@drawable/ic_sources" />

                <ImageButton
                    android:id="@+id/btnFlip"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/icon_button_background"
                    android:contentDescription="Switch camera"
                    android:src="@drawable/ic_flip_camera" />

                <ImageButton
                    android:id="@+id/btnText"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/icon_button_background"
                    android:contentDescription="Add text, ticker or logo"
                    android:src="@drawable/ic_text" />

                <ImageButton
                    android:id="@+id/btnLayers"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/icon_button_background"
                    android:contentDescription="Layers and scene"
                    android:src="@drawable/ic_layout" />

                <ImageButton
                    android:id="@+id/btnMic"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/icon_button_background"
                    android:contentDescription="Mute microphone"
                    android:src="@drawable/ic_mic" />

                <ImageButton
                    android:id="@+id/btnBlackout"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/icon_button_background"
                    android:contentDescription="Black screen mode"
                    android:src="@drawable/ic_moon" />

            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/mainRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnRecord"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_margin="4dp"
                android:background="@drawable/icon_button_background"
                android:contentDescription="Record"
                android:src="@drawable/ic_record" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLive"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:minWidth="130dp"
                android:text="GO LIVE"
                android:textStyle="bold"
                app:backgroundTint="@color/live_red"
                app:cornerRadius="28dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- black-screen overlay: GPU preview detached, brightness minimal -->
    <FrameLayout
        android:id="@+id/blackout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/blackoutHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Streaming with screen dimmed\nTap 3 times to wake"
            android:textAlignment="center"
            android:textColor="#33FFFFFF"
            android:textSize="12sp" />
    </FrameLayout>

    <!-- kiosk: visible exit button (top-left). Tapping asks for the PIN. -->
    <ImageButton
        android:id="@+id/kioskExit"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:alpha="0.75"
        android:background="@drawable/icon_button_background"
        android:contentDescription="Exit kiosk mode"
        android:src="@drawable/ic_lock"
        android:visibility="gone" />
</FrameLayout>
